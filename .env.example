# Copy to .env for local development. NEVER put real keys or funds here — toy values only.
# The defaults below are Anvil's well-known deterministic accounts (public knowledge).

# --- Chain ---------------------------------------------------------------------------------
# Local forge-fhevm stack on Anvil (chainId 31337). For Sepolia, point this at your RPC.
RPC_URL=http://127.0.0.1:8545

# --- Keys (Anvil defaults — toy EOAs only) -------------------------------------------------
# Account #0 — deploys the token and funds/shields the alice & bob accounts (via `populate`).
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Account #1 / #2 — the "alice" / "bob" actors that sign shields/transfers in `populate`.
ALICE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BOB_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Account #3 — the "indexer holder" (user3). Only RECEIVES confidential transfers; never
# signs a self-initiated tx. Used by the `populate` script (and later the indexer).
HOLDER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
HOLDER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# --- Deployed contract addresses (filled in after `npm run deploy`) ------------------------
MOCK_USD_ADDRESS=
CONFIDENTIAL_USD_ADDRESS=

# --- fhEVM local host addresses (canonical; materialized by forge-fhevm deploy-local.sh) ---
# Provided for the indexer's Zama SDK chain config (chainId 31337). These are fixed for the
# local cleartext stack and match @fhevm/solidity ZamaConfig._getLocalConfig().
ACL_ADDRESS=0x50157CFfD6bBFA2DECe204a89ec419c23ef5755D
FHEVM_EXECUTOR_ADDRESS=0xe3a9105a3a932253A70F126eb1E3b589C643dD24
KMS_VERIFIER_ADDRESS=0x901F8942346f7AB3a01F6D7613119Bca447Bb030
INPUT_VERIFIER_ADDRESS=0x36772142b74871f255CbD7A3e89B401d3e45825f

# --- Indexer / API service (indexer/, Ponder) ----------------------------------------------
# The Ponder indexer reads RPC_URL + CONFIDENTIAL_USD_ADDRESS above and serves on port 42069
# (override with `ponder dev --port <n>`). The indexer persists to Postgres (run `make db-up` to
# start the Dockerized DB); the URL below matches docker-compose.yml. Unset DATABASE_URL to fall
# back to Ponder's embedded PGLite store.
DATABASE_URL=postgresql://ponder:ponder@localhost:5432/zama_indexer
INDEXER_START_BLOCK=0
POLL_INTERVAL_MS=2000
